datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  attendances Attendance[] // 出退勤記録とのリレーション
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId    Int
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
}
